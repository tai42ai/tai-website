---
import "@fontsource-variable/inter";
import "@fontsource-variable/geist-mono";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TAI42 - The Open Agent Platform Company",
  description = "TAI42 builds an open-source, MCP-native agent platform - framework, plugins, Studio UI, and CLI - plus Babelfish Flows, a deterministic, auditable flow engine for agent workflows.",
} = Astro.props;

const siteUrl = Astro.site?.href || "https://tai42.ai";
const ogImage = `${siteUrl}og-image.png`;
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="155x155" href="/logos/tai42-logo-icon.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="155x155"
      media="(prefers-color-scheme: dark)"
      href="/logos/tai42-logo-icon-dark.png"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / WhatsApp Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={pageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Canonical -->
    <link rel="canonical" href={pageUrl} />

    <!-- Analytics — Plausible. One custom event only: qualified_form_submission
         (props: page, source), fired from the thank-you page. -->
    <script is:inline defer data-domain="tai42.ai" src="https://plausible.io/js/script.js"></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };
    </script>
  </head>
  <body class="bg-white text-charcoal font-sans antialiased">
    <!-- Skip to content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:px-4 focus:py-2 focus:bg-crimson focus:text-white focus:rounded-md focus:text-sm focus:font-medium"
    >
      Skip to main content
    </a>

    <slot />
  </body>
</html>
