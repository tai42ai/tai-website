---
import "@fontsource-variable/inter";
import "@fontsource-variable/geist-mono";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "tai42 — we take AI from demo to production",
  description = "tai42 turns fragile AI demos into production systems that don't fall over — deterministic where money changes hands, intelligent where judgment is needed.",
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.href || "https://tai42.ai";
const ogImage = `${siteUrl}og-image.png`;
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="155x155" href="/logos/tai42-logo-icon.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="155x155"
      media="(prefers-color-scheme: dark)"
      href="/logos/tai42-logo-icon-dark.png"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / WhatsApp Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="tai42 logo" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {!noindex && <meta property="og:url" content={pageUrl} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="tai42 logo" />

    {/* Canonical — omitted on noindex pages: 404.html is served at every unknown
        URL, so its canonical would name a page that does not exist, and a page
        we ask crawlers to skip has no canonical URL to declare. og:url goes with
        it, for the same reason. */}
    {!noindex && <link rel="canonical" href={pageUrl} />}

    <!-- Analytics — Plausible. Page views only: the site has no forms and fires
         no custom events. -->
    <script is:inline defer data-domain="tai42.ai" src="https://plausible.io/js/script.js"></script>
  </head>
  <body class="bg-white text-charcoal font-sans antialiased">
    <!-- Skip to content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:px-4 focus:py-2 focus:bg-crimson focus:text-white focus:rounded-md focus:text-sm focus:font-medium"
    >
      Skip to main content
    </a>

    <slot />
  </body>
</html>
