---
// ScreenshotSlot — a product screenshot that is not published yet. The slot
// stays in the page with its real path and alt text; nothing renders (no <img>,
// no empty frame) until `show` is flipped to true on that one instance — the
// flag alone gates the markup, so drop the file into public/ BEFORE flipping
// or the image renders broken. No placeholder text is ever shown to a visitor.

interface Props {
  /** Path under /public, e.g. "/images/platform/visual-builder.png". */
  src: string;
  alt: string;
  /** Flip to true once the file is in the repo. */
  show?: boolean;
}

const { src, alt, show = false } = Astro.props;
---

{show && (
  <figure class="mt-6 overflow-hidden rounded-xl border border-gray-200 bg-white">
    <img src={src} alt={alt} class="block w-full h-auto" loading="lazy" decoding="async" />
  </figure>
)}
