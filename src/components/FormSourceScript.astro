---
// FormSourceScript — the shared inline script behind every form on the site
// (currently /contact and /builders). It stamps three things onto each form
// marked `data-source-form`:
//
//   * `source`   — how the visitor arrived (UTM, the referring site's host, or
//                  "direct" — host only, matching what /privacy promises)
//   * `_next`    — Formspree's custom redirect, with the same source passed on
//                  in the query so the thank-you page can fire one analytics
//                  event with it
//   * `_subject` — Formspree's subject line, with the company appended live as
//                  the visitor types it, and re-synced on submit so an autofill
//                  or a session restore (neither fires `input`) still counts
//
// Every write is derived from the input's `defaultValue` (the value attribute
// rendered by Astro), so a re-run — bfcache, history restore, a second keypress
// — recomputes rather than appends twice.
---

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var utm = ["utm_source", "utm_medium", "utm_campaign"]
      .map(function (key) {
        return params.get(key);
      })
      .filter(Boolean)
      .join("|");

    var referrer = "";
    if (document.referrer) {
      try {
        var referrerHost = new URL(document.referrer).host;
        if (referrerHost && referrerHost !== window.location.host) {
          // Host only — never the path or query, so the stored value is
          // exactly "the site that referred you" and nothing more.
          referrer = referrerHost;
        }
      } catch (e) {
        /* unparseable referrer — treat as direct */
      }
    }

    var source = utm || referrer || "direct";

    document.querySelectorAll("form[data-source-form]").forEach(function (form) {
      var sourceInput = form.querySelector('input[name="source"]');
      if (sourceInput) sourceInput.value = source;

      var nextInput = form.querySelector('input[name="_next"]');
      if (nextInput) {
        var base = nextInput.defaultValue;
        nextInput.value =
          base +
          (base.indexOf("?") === -1 ? "?" : "&") +
          "source=" +
          encodeURIComponent(source);
      }

      var subjectInput = form.querySelector('input[name="_subject"]');
      var companyInput = form.querySelector('input[name="company"]');
      if (subjectInput && companyInput) {
        var syncSubject = function () {
          var company = companyInput.value.trim();
          subjectInput.value =
            subjectInput.defaultValue + (company ? " — " + company : "");
        };
        companyInput.addEventListener("input", syncSubject);
        // Autofill and session restore can repopulate the field without an
        // `input` event, so sync once more as the form leaves.
        form.addEventListener("submit", syncSubject);
        syncSubject();
      }
    });
  })();
</script>
