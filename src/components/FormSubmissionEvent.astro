---
// FormSubmissionEvent — the one custom Plausible event on the site,
// `qualified_form_submission`, fired from a thank-you page.
//
// `page` says which form was submitted and comes from the route, not from a
// query parameter: /thank-you/ is the contact form's landing page and
// /thank-you-builders/ is the waitlist's, so the value cannot be spoofed or
// dropped by a redirect that loses its query string. `source` still travels in
// the query, stamped onto `_next` by FormSourceScript.
//
// The sessionStorage key covers page + source, so a reload or a back-navigation
// inside the same session does not double-count one submission.

interface Props {
  page: string;
}

const { page } = Astro.props;
---

<script is:inline define:vars={{ page }}>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var source = params.get("source") || "";

    var key = "qualified_form_submission:" + page + ":" + source;
    try {
      if (window.sessionStorage.getItem(key)) return;
      window.sessionStorage.setItem(key, "1");
    } catch (e) {
      /* private mode — fire anyway */
    }

    if (typeof window.plausible === "function") {
      window.plausible("qualified_form_submission", {
        props: { page: page, source: source },
      });
    }
  })();
</script>
