---
// NavBar — company navigation: Open Source, Babelfish, Pricing, Docs (external), Company
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(href + "/");
const linkClass = (href: string) => isActive(href) ? "px-3 py-2 text-sm font-semibold text-crimson rounded-lg transition-colors" : "px-3 py-2 text-sm font-medium text-charcoal/70 hover:text-crimson rounded-lg transition-colors";
const dropdownParentClass = (prefixes: string[]) => prefixes.some(p => isActive(p)) ? "flex items-center gap-1 px-3 py-2 text-sm font-semibold text-crimson rounded-lg transition-colors" : "flex items-center gap-1 px-3 py-2 text-sm font-medium text-charcoal/70 hover:text-crimson rounded-lg transition-colors";
const dropdownItemClass = (href: string) => isActive(href) ? "block px-4 py-2.5 text-sm text-crimson bg-gray-50 transition-colors" : "block px-4 py-2.5 text-sm text-charcoal/70 hover:text-crimson hover:bg-gray-50 transition-colors";
const mobileClass = (href: string) => isActive(href) ? "mobile-nav-link block px-3 py-2.5 text-sm font-semibold text-crimson hover:bg-gray-50 rounded-lg transition-colors" : "mobile-nav-link block px-3 py-2.5 text-sm font-medium text-charcoal/70 hover:text-crimson hover:bg-gray-50 rounded-lg transition-colors";
const mobileSubClass = (href: string) => isActive(href) ? "mobile-nav-link block px-3 py-2 text-sm font-semibold text-crimson hover:bg-gray-50 rounded-lg transition-colors" : "mobile-nav-link block px-3 py-2 text-sm text-charcoal/60 hover:text-crimson hover:bg-gray-50 rounded-lg transition-colors";

const GITHUB_URL = "https://github.com/tai42ai";
const DOCS_URL = "https://docs.tai42.ai";
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-lg border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center shrink-0">
        <img src="/logos/tai42-logo.png" alt="TAI42" class="h-12 w-auto" />
      </a>

      <!-- Desktop nav links -->
      <div class="hidden lg:flex items-center gap-1">
        <a href="/open-source" class={linkClass("/open-source")}>
          Open Source
        </a>
        <a href="/babelfish" class={linkClass("/babelfish")}>
          Babelfish
        </a>
        <a href="/pricing" class={linkClass("/pricing")}>
          Pricing
        </a>
        <a
          href={DOCS_URL}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-charcoal/70 hover:text-crimson rounded-lg transition-colors"
        >
          Docs
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>

        <!-- Company dropdown -->
        <div class="group relative">
          <button class={dropdownParentClass(["/company/about", "/company/contact", "/company/careers"])}>
            Company
            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 absolute top-full right-0 mt-1 w-48 bg-white border border-gray-200 rounded-xl shadow-lg py-2 transition-all duration-150">
            <a href="/company/about" class={dropdownItemClass("/company/about")}>
              About
            </a>
            <a href="/company/contact" class={dropdownItemClass("/company/contact")}>
              Contact
            </a>
            <a href="/company/careers" class={dropdownItemClass("/company/careers")}>
              Careers
            </a>
          </div>
        </div>
      </div>

      <!-- Right side: CTA + Mobile toggle -->
      <div class="flex items-center gap-3">
        <a
          href="/company/contact"
          class="hidden lg:inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-crimson hover:bg-burgundy rounded-lg transition-colors btn-hover"
        >
          Talk to us
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden flex items-center justify-center w-9 h-9 rounded-lg hover:bg-gray-50 transition-colors"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg class="w-5 h-5 text-charcoal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-gray-200 bg-white/95 backdrop-blur-lg">
    <div class="px-4 py-3 space-y-1">
      <a href="/open-source" class={mobileClass("/open-source")}>
        Open Source
      </a>
      <a href="/babelfish" class={mobileClass("/babelfish")}>
        Babelfish
      </a>
      <a href="/pricing" class={mobileClass("/pricing")}>
        Pricing
      </a>
      <a
        href={DOCS_URL}
        target="_blank"
        rel="noopener"
        class="mobile-nav-link block px-3 py-2.5 text-sm font-medium text-charcoal/70 hover:text-crimson hover:bg-gray-50 rounded-lg transition-colors"
      >
        Docs &nearr;
      </a>

      <!-- Company group -->
      <div>
        <button
          class="mobile-accordion-btn w-full flex items-center justify-between px-3 py-2.5 text-sm font-medium text-charcoal/70 hover:text-crimson hover:bg-gray-50 rounded-lg transition-colors"
          aria-expanded="false"
        >
          Company
          <svg class="mobile-accordion-icon w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <div class="mobile-accordion-panel hidden pl-4 space-y-0.5">
          <a href="/company/about" class={mobileSubClass("/company/about")}>
            About
          </a>
          <a href="/company/contact" class={mobileSubClass("/company/contact")}>
            Contact
          </a>
          <a href="/company/careers" class={mobileSubClass("/company/careers")}>
            Careers
          </a>
        </div>
      </div>

      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        class="mobile-nav-link block px-3 py-2.5 text-sm font-medium text-charcoal/70 hover:text-crimson hover:bg-gray-50 rounded-lg transition-colors"
      >
        GitHub &nearr;
      </a>

      <div class="pt-2 border-t border-gray-200">
        <a
          href="/company/contact"
          class="mobile-nav-link block w-full text-center px-4 py-2.5 text-sm font-semibold text-white bg-crimson hover:bg-burgundy rounded-lg transition-colors"
        >
          Talk to us
        </a>
      </div>
    </div>
  </div>
</nav>

<!-- Spacer for fixed nav -->
<div class="h-16"></div>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const expanded = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("hidden");
  });

  // Mobile accordion toggles
  document.querySelectorAll(".mobile-accordion-btn").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const panel = toggle.nextElementSibling as HTMLElement | null;
      const icon = toggle.querySelector(".mobile-accordion-icon");
      if (!panel) return;

      const isOpen = !panel.classList.contains("hidden");
      panel.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!isOpen));
      icon?.classList.toggle("rotate-180");
    });
  });

  // Close mobile menu on nav link click
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
    });
  });
</script>
