---
// NavBar — Home · How it works · Platform · Open Source · Docs · About · Contact,
// plus the one primary CTA ("Get your production readiness report" → /contact/
// — the page, not its mailto button). Docs points at the
// separate docs site and opens in the same tab, styled like every other item.
// Compare paths with trailing slashes stripped, so a link written as "/method/"
// matches the request path whether or not it carries the slash. Absolute
// (off-site) hrefs are never active.
const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const pathname = normalize(Astro.url.pathname);
const isActive = (href: string) => {
  if (!href.startsWith("/")) return false;
  const target = normalize(href);
  return target === "/" ? pathname === "/" : pathname === target || pathname.startsWith(target + "/");
};
const linkClass = (href: string) => isActive(href) ? "px-3 py-2 text-sm font-semibold text-crimson rounded-lg transition-colors" : "px-3 py-2 text-sm font-medium text-charcoal/70 hover:text-crimson rounded-lg transition-colors";
const mobileClass = (href: string) => isActive(href) ? "mobile-nav-link block px-3 py-2.5 text-sm font-semibold text-crimson hover:bg-gray-50 rounded-lg transition-colors" : "mobile-nav-link block px-3 py-2.5 text-sm font-medium text-charcoal/70 hover:text-crimson hover:bg-gray-50 rounded-lg transition-colors";

const NAV_LINKS = [
  { href: "/", label: "Home" },
  { href: "/method/", label: "How it works" },
  { href: "/platform/", label: "Platform" },
  { href: "/open-source/", label: "Open Source" },
  { href: "https://docs.tai42.ai", label: "Docs" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-lg border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center shrink-0">
        <img src="/logos/tai42-logo.png" alt="tai42" class="h-12 w-auto" />
      </a>

      <!-- Desktop nav links -->
      <div class="hidden lg:flex items-center gap-1">
        {NAV_LINKS.map((link) => (
          <a href={link.href} class={linkClass(link.href)}>{link.label}</a>
        ))}
      </div>

      <!-- Right side: CTA + Mobile toggle -->
      <div class="flex items-center gap-3">
        <a
          href="/contact/"
          class="hidden lg:inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-crimson hover:bg-burgundy rounded-lg transition-colors btn-hover"
        >
          Get your production readiness report
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden flex items-center justify-center w-9 h-9 rounded-lg hover:bg-gray-50 transition-colors"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg class="w-5 h-5 text-charcoal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-gray-200 bg-white/95 backdrop-blur-lg">
    <div class="px-4 py-3 space-y-1">
      {NAV_LINKS.map((link) => (
        <a href={link.href} class={mobileClass(link.href)}>{link.label}</a>
      ))}

      <div class="pt-2 border-t border-gray-200">
        <a
          href="/contact/"
          class="mobile-nav-link block w-full text-center px-4 py-2.5 text-sm font-semibold text-white bg-crimson hover:bg-burgundy rounded-lg transition-colors"
        >
          Get your production readiness report
        </a>
      </div>
    </div>
  </div>
</nav>

<!-- Spacer for fixed nav -->
<div class="h-16"></div>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const expanded = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("hidden");
  });

  // Close mobile menu on nav link click
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
    });
  });
</script>
