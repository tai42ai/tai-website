---
import Reveal from "../components/Reveal.astro";
---

<section id="final-cta" class="bg-white py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Reveal>
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-black mb-6">
          Build on the open platform. Ship with Babelfish.
        </h2>
        <p class="text-lg text-charcoal/70 max-w-xl mx-auto mb-10 leading-relaxed">
          Self-host the open-source platform today, or run Babelfish Flows and
          TAI42 Cloud for production-grade deterministic agents.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4 mb-4">
          <a
            href="/open-source"
            class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
          >
            Explore the platform
          </a>
          <a
            href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ3qmPX-JW-HScqfCyMv1v_hyyxGRl2J8b7JOptbl36xFUSe7oz3AvSASK-SYjBeswKDpQcLIn2n"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center border-2 border-crimson text-crimson hover:bg-crimson hover:text-white rounded-lg px-8 py-3.5 font-semibold transition-colors"
          >
            Let&rsquo;s talk
          </a>
        </div>
        <p class="text-sm text-charcoal/50">
          Open source &middot; Self-hosted &middot; No phone-home.
        </p>
      </div>
    </Reveal>
  </div>
</section>
