---
// Footer — column layout: Platform, Resources, Company, Legal
const GITHUB_URL = "https://github.com/tai42ai";
const DOCS_URL = "https://docs.tai42.ai";
---

<footer class="bg-white border-t border-gray-200">
  <!-- Links grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Platform -->
      <div>
        <h3 class="text-xs font-semibold text-charcoal/40 uppercase tracking-wider mb-4">Platform</h3>
        <ul class="space-y-2.5">
          <li><a href="/open-source" class="text-sm text-charcoal/60 hover:text-crimson transition-colors">Open Source</a></li>
          <li><a href="/babelfish" class="text-sm text-charcoal/60 hover:text-crimson transition-colors">Babelfish</a></li>
          <li><a href="/pricing" class="text-sm text-charcoal/60 hover:text-crimson transition-colors">Pricing</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-xs font-semibold text-charcoal/40 uppercase tracking-wider mb-4">Resources</h3>
        <ul class="space-y-2.5">
          <li><a href={DOCS_URL} target="_blank" rel="noopener" class="text-sm text-charcoal/60 hover:text-crimson transition-colors">Docs</a></li>
          <li><a href={GITHUB_URL} target="_blank" rel="noopener" class="text-sm text-charcoal/60 hover:text-crimson transition-colors">GitHub</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-xs font-semibold text-charcoal/40 uppercase tracking-wider mb-4">Company</h3>
        <ul class="space-y-2.5">
          <li><a href="/company/about" class="text-sm text-charcoal/60 hover:text-crimson transition-colors">About</a></li>
          <li><a href="/company/contact" class="text-sm text-charcoal/60 hover:text-crimson transition-colors">Contact</a></li>
          <li><a href="/company/careers" class="text-sm text-charcoal/60 hover:text-crimson transition-colors">Careers</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-xs font-semibold text-charcoal/40 uppercase tracking-wider mb-4">Legal</h3>
        <ul class="space-y-2.5">
          <li><a href="/privacy" class="text-sm text-charcoal/60 hover:text-crimson transition-colors">Privacy</a></li>
          <li><a href="/security" class="text-sm text-charcoal/60 hover:text-crimson transition-colors">Security</a></li>
          <li><a href="/terms" class="text-sm text-charcoal/60 hover:text-crimson transition-colors">Terms</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <img src="/logos/tai42-logo.png" alt="TAI42" class="h-9 w-auto opacity-40" />
          <p class="text-sm text-charcoal/40">&copy; {new Date().getFullYear()} TAI42. All rights reserved.</p>
        </div>
        <div class="flex items-center gap-4">
          <a href={GITHUB_URL} target="_blank" rel="noopener" class="text-sm text-charcoal/40 hover:text-crimson transition-colors">GitHub</a>
          <a href={DOCS_URL} target="_blank" rel="noopener" class="text-sm text-charcoal/40 hover:text-crimson transition-colors">Docs</a>
          <a href="/company/contact" class="text-sm text-charcoal/40 hover:text-crimson transition-colors">Contact</a>
        </div>
      </div>
    </div>
  </div>
</footer>
