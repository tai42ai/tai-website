---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";

export const prerender = true;

// The site is email-only (decision 20 Aug): no forms, no form backend, no
// thank-you pages, no source tag, nothing written to browser storage. What is
// left is Plausible page views (the script is loaded in BaseLayout — that is
// what the analytics section describes) and the two Group mailboxes.
---

<BaseLayout
  title="Privacy — tai42"
  description="This website is a static site with no accounts, no cookies, and no forms. Here is exactly what it collects: aggregate page statistics, and whatever you choose to write to us."
>
  <NavBar />
  <main id="main-content">
    <!-- Header -->
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-black mb-8">
            Your data is yours.<br />Here is exactly what this site collects.
          </h1>
        </Reveal>

        <Reveal delay={100}>
          <div class="bg-gray-50 rounded-xl border border-gray-200 p-6 lg:p-8 max-w-3xl">
            <p class="text-charcoal/70 leading-relaxed">
              This website is a static site. It has no accounts, no cookies, no
              forms, and no cross-site tracking. Two things do reach us:
              aggregate page statistics from an analytics service that sets no
              cookies, and whatever you choose to write to us by email. Both are
              spelled out below.
            </p>
          </div>
        </Reveal>
      </div>
    </section>

    <!-- What this site collects — no fill of its own: it closes the white band -->
    <section class="pb-20 lg:pb-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-2xl sm:text-3xl font-bold text-black mb-8">What this site collects</h2>
        </Reveal>

        <div class="space-y-6">
          <Reveal delay={100}>
            <div class="bg-gray-50 rounded-xl border border-gray-200 p-6 lg:p-8">
              <h3 class="text-xl font-bold text-black mb-3">No accounts, no cookies, no tracking</h3>
              <p class="text-charcoal/70 leading-relaxed">
                We never ask you to create an account, and nothing here sets a
                cookie — not the site, not our analytics. Nothing is written to
                your browser's storage either: the site has no forms and no
                confirmation pages, so there is nothing to remember. You are not
                followed across other websites, and no personal profile of you is
                built.
              </p>
            </div>
          </Reveal>

          <Reveal delay={200}>
            <div class="bg-gray-50 rounded-xl border border-gray-200 p-6 lg:p-8">
              <h3 class="text-xl font-bold text-black mb-3">Aggregate page statistics</h3>
              <p class="text-charcoal/70 leading-relaxed">
                We use Plausible, which counts page views in aggregate — which
                pages are read, how often, and other aggregate dimensions such as
                country and device type. Like any web request, the analytics
                request carries standard technical data (such as your IP address
                and browser type); Plausible sets no cookies, and what reaches us
                are aggregate totals, not individual visitors. Page views are the
                only measurement: the site fires no other events.
              </p>
            </div>
          </Reveal>

          <Reveal delay={300}>
            <div class="bg-gray-50 rounded-xl border border-gray-200 p-6 lg:p-8">
              <h3 class="text-xl font-bold text-black mb-3">Hosting logs are our host&rsquo;s</h3>
              <p class="text-charcoal/70 leading-relaxed">
                This site is served by GitHub Pages. Like any web host, GitHub
                receives standard request data (such as your IP address and
                browser type) in order to deliver the page. That processing is
                governed by GitHub&rsquo;s privacy statement — we operate no
                logging of our own.
              </p>
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- When you write to us -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-2xl sm:text-3xl font-bold text-black mb-6">When you write to us</h2>
        </Reveal>
        <Reveal delay={100}>
          <p class="text-charcoal/70 leading-relaxed max-w-3xl">
            There is no form to fill in. Writing to
            <a href="mailto:contact@tai42.ai" class="font-medium text-crimson hover:text-burgundy transition-colors">contact@tai42.ai</a>
            or
            <a href="mailto:builders@tai42.ai" class="font-medium text-crimson hover:text-burgundy transition-colors">builders@tai42.ai</a>
            sends an ordinary email, received in a Google Workspace group inbox.
            We use what you send only to reply to you and to schedule a
            conversation: no CRM, no automated sequence, nothing sold and nothing
            passed on. Ask us to delete what you sent, and we delete it.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- Who is responsible & your rights -->
    <section class="bg-white py-20 lg:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-2xl sm:text-3xl font-bold text-black mb-6">Who is responsible &amp; your rights</h2>
        </Reveal>
        <Reveal delay={100}>
          <p class="text-charcoal/70 leading-relaxed max-w-3xl">
            This site is operated by tai42; write to
            <a href="mailto:contact@tai42.ai" class="font-medium text-crimson hover:text-burgundy transition-colors">contact@tai42.ai</a>.
            You can ask at any time what we hold about you, and have it corrected
            or deleted. Providers that handle data on the way: GitHub hosts the
            site and receives standard request data, Plausible receives the
            analytics request, and Google carries our mail and our calendar —
            each processing it under its own terms.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- The runtime you self-host, the platform we host -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-2xl sm:text-3xl font-bold text-black mb-6">The runtime you self-host, the platform we host</h2>
        </Reveal>
        <Reveal delay={100}>
          <p class="text-charcoal/70 leading-relaxed max-w-3xl">
            This policy covers this website only. The open-source runtime runs
            entirely on your own infrastructure when you self-host it, and makes
            no phone-home to us — your prompts, payloads, and data never reach
            our servers, because there is no server of ours in that path. The
            hosted BabelFish platform is the other case: it runs in a private,
            dedicated, EU-hosted tenant your team operates, and what it
            processes there is governed by the agreement covering that tenant,
            not by this policy.
          </p>
        </Reveal>
        <Reveal delay={200}>
          <p class="mt-6 text-charcoal/70 leading-relaxed max-w-3xl">
            Questions about any of this, or about data you have sent us? Reach
            us through our
            <a href="/contact/" class="font-medium text-crimson hover:text-burgundy transition-colors">contact page</a>.
          </p>
        </Reveal>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
