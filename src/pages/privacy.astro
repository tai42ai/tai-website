---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";

export const prerender = true;
---

<BaseLayout
  title="Privacy — tai42"
  description="This website is a static site with no accounts and no cookies. Here is exactly what it collects: aggregate page statistics, and whatever you type into a form."
>
  <NavBar />
  <main id="main-content" class="pt-20">
    <!-- Header Section -->
    <section class="bg-white py-20 sm:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Reveal>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-black mb-8">
            Your Data is Yours.<br />Here Is Exactly What This Site Collects.
          </h1>
        </Reveal>

        <!-- Highlighted callout box -->
        <Reveal delay={100}>
          <div class="bg-crimson/5 border border-crimson/20 rounded-xl p-6 text-left max-w-3xl mx-auto">
            <p class="text-charcoal/80 leading-relaxed">
              This website is a static site. It has no accounts, no cookies, and
              no cross-site tracking. Two things do reach us: aggregate page
              statistics from an analytics service that sets no cookies, and
              whatever you choose to type into one of our forms. Both are
              spelled out below.
            </p>
          </div>
        </Reveal>
      </div>
    </section>

    <!-- What this site collects -->
    <section class="bg-white py-16 sm:py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-2xl sm:text-3xl font-bold text-black mb-8">What This Site Collects</h2>
        </Reveal>

        <div class="space-y-4">
          <Reveal delay={100}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 flex gap-4">
              <div class="shrink-0 w-10 h-10 rounded-full bg-error/10 flex items-center justify-center mt-0.5">
                <!-- Red X -->
                <svg class="w-5 h-5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-black mb-2">No Accounts, No Cookies, No Tracking</h3>
                <p class="text-sm text-charcoal/70 leading-relaxed">
                  We never ask you to create an account, and nothing here sets a
                  cookie - not the site, not our analytics. The one thing kept
                  in your browser is a short-lived session-storage entry written
                  by our thank-you page, used solely so that reloading it does
                  not count the same form confirmation twice; it clears when you
                  close the tab. You are not followed across other websites, and
                  no personal profile of you is built.
                </p>
              </div>
            </div>
          </Reveal>

          <Reveal delay={200}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 flex gap-4">
              <div class="shrink-0 w-10 h-10 rounded-full bg-success/10 flex items-center justify-center mt-0.5">
                <!-- Green checkmark -->
                <svg class="w-5 h-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-black mb-2">Aggregate Page Statistics</h3>
                <p class="text-sm text-charcoal/70 leading-relaxed">
                  We use Plausible, which counts page views in aggregate - which
                  pages are read, and how often. Like any web request, the
                  analytics request carries standard technical data (such as
                  your IP address and browser type); Plausible sets no cookies,
                  and what reaches us are aggregate totals, not individual
                  visitors. There is one event beyond page views: when a form
                  submission lands on our thank-you page, we record that it
                  happened, which form it came from, and how the visitor arrived.
                </p>
              </div>
            </div>
          </Reveal>

          <Reveal delay={300}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 flex gap-4">
              <div class="shrink-0 w-10 h-10 rounded-full bg-success/10 flex items-center justify-center mt-0.5">
                <!-- Green checkmark -->
                <svg class="w-5 h-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-black mb-2">Hosting Logs Are Our Host&rsquo;s</h3>
                <p class="text-sm text-charcoal/70 leading-relaxed">
                  This site is served by GitHub Pages. Like any web host, GitHub
                  receives standard request data (such as your IP address and
                  browser type) in order to deliver the page. That processing is
                  governed by GitHub&rsquo;s privacy statement - we operate no
                  logging of our own.
                </p>
              </div>
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- When you contact us -->
    <section class="bg-gray-50 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-2xl sm:text-3xl font-bold text-black mb-6">When You Contact Us</h2>
        </Reveal>
        <Reveal delay={100}>
          <p class="text-charcoal/70 leading-relaxed max-w-3xl">
            The forms on our
            <a href="/contact/" class="font-medium text-crimson hover:text-burgundy transition-colors">contact page</a>
            and our
            <a href="/builders/" class="font-medium text-crimson hover:text-burgundy transition-colors">builders page</a>
            send exactly what you type - your answers to the questions on the
            page, plus the contact details that form asks for (the contact form:
            your name, your company, your email; the builders form: your company
            and your email) - plus a source tag recording how you arrived (a
            campaign link, the site that referred you, or simply
            &ldquo;direct&rdquo;). Delivery runs through Web3Forms, which emails
            the submission to us. We use it only to reply: no CRM, no automated
            sequence, nothing sold or passed on. If you email us directly, the
            same applies. Booking a call runs through Google Calendar&rsquo;s
            appointment page, where Google&rsquo;s own terms govern what they
            receive.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- The software you self-host -->
    <section class="bg-white py-16 sm:py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-2xl sm:text-3xl font-bold text-black mb-6">The Runtime You Self-Host, the Platform We Host</h2>
        </Reveal>
        <Reveal delay={100}>
          <p class="text-charcoal/70 leading-relaxed max-w-3xl">
            This policy covers this website only. The open-source runtime runs
            entirely on your own infrastructure when you self-host it, and makes
            no phone-home to us - your prompts, payloads, and data never reach
            our servers, because there is no server of ours in that path. The
            hosted BabelFish platform is the other case: it runs in a private,
            dedicated, EU-hosted tenant your team operates, and what it
            processes there is governed by the agreement covering that tenant,
            not by this policy.
          </p>
        </Reveal>
        <Reveal delay={200}>
          <p class="mt-6 text-charcoal/70 leading-relaxed max-w-3xl">
            Questions about any of this, or about data you have sent us? Reach
            us through our
            <a href="/contact/" class="font-medium text-crimson hover:text-burgundy transition-colors">contact page</a>.
          </p>
        </Reveal>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
