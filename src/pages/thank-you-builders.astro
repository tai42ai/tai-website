---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";
import FormSubmissionEvent from "../components/FormSubmissionEvent.astro";

export const prerender = true;

// The BUILDERS waitlist thank-you. Deliberately no calendar link: founding
// partners are contacted, not booked (7d). The line below is the /builders
// honest line, said back to the person who just signed up — no new claim.
---

<BaseLayout
  title="You're on the list — tai42"
  description="You're on the founding builders list."
  noindex
>
  <NavBar />

  <main id="main-content">
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Reveal>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-black leading-[1.1] mb-6">
            Thanks — you're on the list.
          </h1>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            Founding partners are invited in small batches as delivery capacity
            opens.
          </p>
        </Reveal>
      </div>
    </section>

    <FormSubmissionEvent page="builders" />
  </main>

  <Footer />
</BaseLayout>
