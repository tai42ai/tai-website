---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";

export const prerender = true;

// No form, no form backend, no thank-you page (decision 20 Aug) — see /contact
// for the note. The waitlist's three prompts are plain text and the button is a
// mailto: with them pre-filled, answered from the builders@ Group mailbox.
// builders@tai42.ai is deliberately public here.
const MAIL_TO = "builders@tai42.ai";
const SUBJECT = "Founding builder";

const DELIVERS = ["agency", "dev shop", "service firm", "operator"];
const DELIVERS_LINE = `What you deliver today (${DELIVERS.join(" / ")})`;

// One prompt per line, each followed by a blank line, so the sender types under
// each; encodeURIComponent turns the \r\n pairs into %0D%0A.
const PROMPTS = ["Company", DELIVERS_LINE, "Roughly how many clients"];
const BODY = PROMPTS.map((prompt) => `${prompt}:\r\n\r\n`).join("");
const MAILTO_HREF = `mailto:${MAIL_TO}?subject=${encodeURIComponent(
  SUBJECT
)}&body=${encodeURIComponent(BODY)}`;
---

<BaseLayout
  title="Your clients. Our engine. — tai42"
  description="tai42's platform will open to a small group of founding partners — agencies, development shops, and service firms who deliver Service-as-Software to their own clients."
>
  <NavBar />

  <main id="main-content">
    <!-- Hero -->
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-black leading-[1.1] mb-6">
            Your clients. Our engine.
          </h1>
        </Reveal>
        <Reveal delay={100}>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            tai42's platform will open to a small group of founding partners —
            agencies, development shops, and service firms who deliver
            Service-as-Software to their own clients.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- Body -->
    <section class="bg-gray-50 py-16 lg:py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            Founding Builders get a multi-tenant workspace to build, operate, and
            bill your own clients — on the same engine behind our production
            deliveries: deterministic flows where money moves, verified payments,
            full audit, humans at the named decisions. Complete client
            applications shipped as configuration, not product code. Economics
            that scale with your clients, not your headcount. We run our own
            company on this platform; founding partners will run their business
            on it too.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- How founding partners come in -->
    <section class="bg-white py-16 lg:py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            Founding partners are invited in small batches as delivery capacity
            opens. Pre-signing tells us who to build for first.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- Waitlist -->
    <section class="bg-gray-50 py-16 lg:py-24">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <div class="rounded-xl border border-gray-200 bg-white p-6 lg:p-8">
            <ul class="space-y-4">
              {PROMPTS.map((prompt) => (
                <li class="flex gap-3 text-lg text-black leading-relaxed">
                  <span class="mt-3 shrink-0 w-1.5 h-1.5 rounded-full bg-crimson/60"></span>
                  <span>{prompt}</span>
                </li>
              ))}
            </ul>

            <div class="mt-8">
              <a
                href={MAILTO_HREF}
                class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
              >
                Join the founding waitlist
              </a>
              <p class="mt-4 text-sm text-charcoal/60 leading-relaxed">
                or write to <a
                  href={`mailto:${MAIL_TO}`}
                  class="font-medium text-crimson hover:text-burgundy transition-colors"
                  >builders@tai42.ai</a
                >.
              </p>
            </div>
          </div>
        </Reveal>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
