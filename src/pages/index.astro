---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";
import { CALENDAR_URL } from "../consts";

export const prerender = true;

const WHY_IT_HOLDS = [
  {
    title: "Gates, not promises.",
    body:
      "Phased delivery with written acceptance criteria and a stop-point at every phase. You can leave at any gate — which is exactly why clients don't.",
  },
  {
    title: "Speed with receipts.",
    body:
      "Weeks, not quarters — on our own platform, with every claim measured on live deliveries before we publish it.",
  },
  {
    title: "The AI can't touch your money.",
    body:
      "In our platform the AI has no tools — it writes and interprets; it cannot fetch data, quote a price, or take an action. Bookings, payments, and prices run as deterministic steps the model never sees. A wrong sentence stays a wrong sentence; it can't become a wrong charge.",
  },
];
---

<BaseLayout
  title="Your AI demo works. Production is where it dies. — tai42"
  description="tai42 turns fragile AI demos into production systems that don't fall over — deterministic where money changes hands, intelligent where judgment is needed."
>
  <NavBar />

  <main id="main-content">
    <!-- Hero -->
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Reveal>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-black leading-[1.1] mb-6">
            Your AI demo works. Production is where it dies.
          </h1>

          <p class="text-lg text-charcoal/70 max-w-2xl mx-auto leading-relaxed mb-8">
            tai42 turns fragile AI demos into production systems that don't fall
            over — deterministic where money changes hands, intelligent where
            judgment is needed. Live with real users in weeks, not quarters —
            against acceptance criteria you sign.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4">
            <a
              href={CALENDAR_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
            >
              Book a production audit
            </a>
          </div>
        </Reveal>
      </div>
    </section>

    <!-- Proof strip + doors line -->
    <section class="bg-gray-50 py-10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Reveal>
          <p class="text-sm text-charcoal/70 leading-relaxed">
            In production with a travel-tech marketplace &middot; Two further
            engagements in delivery &middot; Built on our own platform — and we
            run our own company on the same flows.
          </p>
          <p class="mt-4 text-sm">
            <a href="/builders/" class="font-medium text-crimson hover:text-burgundy transition-colors">
              For builders → join the founding waitlist
            </a>
          </p>
        </Reveal>
      </div>
    </section>

    <!-- The problem -->
    <section class="bg-white py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black mb-6">
            The problem
          </h2>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            The industry's own numbers: the best AI agents complete under a
            third of real workplace tasks. Most enterprise AI pilots never touch
            the P&amp;L. The gap isn't the model — it's the missing structure
            around it.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- What we do -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black mb-6">
            What we do
          </h2>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            We rebuild your demo as a production system: deterministic flows
            wherever money, prices, or commitments move; AI wherever judgment is
            needed; humans at a named handful of decisions. Then we run it with
            you, measure everything, and hand you the controls.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- Why it holds -->
    <section class="bg-white py-20 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black text-center mb-14">
            Why it holds
          </h2>
        </Reveal>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
          {WHY_IT_HOLDS.map((card, i) => (
            <Reveal delay={100 + i * 75}>
              <div class="card-hover bg-white rounded-xl border border-gray-200 p-8 h-full">
                <h3 class="text-xl font-bold text-black mb-3">{card.title}</h3>
                <p class="text-charcoal/70 leading-relaxed">{card.body}</p>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
