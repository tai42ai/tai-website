---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";
import StepLine from "../components/StepLine.astro";
import type { Step } from "../components/StepLine.astro";

export const prerender = true;

// The compressed four-step form of the /method step line: same component, no
// stop-point labels here, every step links through to the full five-step page.
const STEPS: Step[] = [
  {
    title: "Production readiness review (free).",
    body:
      "From a walkthrough and, if you can share them, structural traces — no access, no data — we assess your demo, your definitions, and your integration surface.",
    link: "/method/",
  },
  {
    title: "Build.",
    body:
      "Your system on our platform — deterministic where it must be, intelligent where it should be, instrumented everywhere.",
    link: "/method/",
  },
  {
    title: "Acceptance.",
    body: "Pass/fail criteria you test yourself.",
    link: "/method/",
  },
  {
    title: "Run.",
    body:
      "Your team operates it on a private tenant; we stay for the hard parts.",
    link: "/method/",
  },
];

const WHY_IT_WORKS = [
  {
    title: "Gates, not promises.",
    body:
      "Phased delivery with written acceptance criteria and a stop-point at every phase. You can leave at any gate — which is exactly why clients don't.",
  },
  {
    title: "Speed with receipts.",
    body:
      "Weeks, not quarters — on our own platform, with every claim measured on live deliveries before we publish it.",
  },
  {
    title: "The AI can't touch your money.",
    body:
      "In our platform the AI has no tools — it writes and interprets; it cannot fetch data, quote a price, or take an action. Bookings, payments, and prices run as deterministic steps the model never sees. A wrong sentence stays a wrong sentence; it can't become a wrong charge.",
  },
];
---

<BaseLayout
  title="AI, from demo to production. — tai42"
  description="Tai42 takes AI into production — turning your working demo into a production application: deterministic where money moves, AI where judgment is needed, humans at the decisions you name."
>
  <NavBar />

  <main id="main-content">
    <!-- Hero — H1 · sub · CTA only -->
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-black leading-[1.1] mb-6">
            AI, from demo to production.
          </h1>

          <p class="text-lg text-charcoal/70 max-w-2xl leading-relaxed mb-8">
            Tai42 takes AI into production — turning your working demo into a
            production application: deterministic where money moves, AI where
            judgment is needed, humans at the decisions you name. Live with real
            users in weeks, not quarters, against acceptance criteria you sign.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <a
              href="/contact/"
              class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
            >
              Get your production readiness report
            </a>
          </div>
        </Reveal>
      </div>
    </section>

    <!-- How it works -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black mb-6">
            How it works
          </h2>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            We rebuild your demo as a production application: deterministic
            flows wherever money, prices, or commitments move; AI wherever
            judgment is needed; humans at a named handful of decisions. Then we
            run it with you, measure everything, and hand you the controls.
          </p>
        </Reveal>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-14 lg:mt-16">
        <StepLine steps={STEPS} />
      </div>

      <!-- Three things, one company -->
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 lg:mt-20">
        <Reveal>
          <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8">
            <h3 class="text-xl font-bold text-black mb-3">
              Three things, one company.
            </h3>
            <p class="text-charcoal/70 leading-relaxed">
              An open-source runtime — the engine, public, read it and run it.
              BabelFish, the platform built on that runtime — private tenants
              your team operates, where the engineering lives. And the
              engagements we deliver with it — your demo to a production
              application, humans at the decisions you name. We run our own
              company on all three. (<a
                href="/about/"
                class="font-medium text-crimson hover:text-burgundy transition-colors"
                >&rarr; About</a
              >)
            </p>
          </div>
        </Reveal>
      </div>
    </section>

    <!-- What we build -->
    <section class="bg-white py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black mb-6">
            What we build
          </h2>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            Customer-facing commerce applications on messaging channels —
            WhatsApp, Telegram, SMS, web. Internal operating systems in the
            tools your team already uses — Slack, Jira. Machine-facing products
            behind an MCP gateway. One engine behind all of them.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- Why it works -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black mb-14">
            Why it works
          </h2>
        </Reveal>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
          {WHY_IT_WORKS.map((card, i) => (
            <Reveal delay={100 + i * 75}>
              <div class="card-hover bg-white rounded-xl border border-gray-200 p-8 h-full">
                <h3 class="text-xl font-bold text-black mb-3">{card.title}</h3>
                <p class="text-charcoal/70 leading-relaxed">{card.body}</p>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    <!-- The other doors -->
    <section class="bg-white py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <div class="bg-gray-50 rounded-xl border border-gray-200 p-6 lg:p-8">
            <p>
              <a
                href="/builders/"
                class="font-medium text-crimson hover:text-burgundy transition-colors"
              >
                For builders &rarr; join the founding waitlist
              </a>
            </p>
          </div>
        </Reveal>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <a
            href="/contact/"
            class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
          >
            Get your production readiness report
          </a>
        </Reveal>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
