---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";
import ScreenshotSlot from "../components/ScreenshotSlot.astro";

export const prerender = true;

const DOCS_URL = "https://docs.tai42.ai";

// The three product screenshots are not in the repo yet. Each slot below keeps
// its real path and alt text; drop the file into /public/images/platform/ and
// set `show` to true on that one instance to publish it.
---

<BaseLayout
  title="BabelFish — one engine for business functions in production — tai42"
  description="The platform every tai42 application runs on — built on our open-source runtime, delivered as a private tenant your team operates, or self-hosted on your own infrastructure."
>
  <NavBar />

  <main id="main-content">
    <!-- Hero -->
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Reveal>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-black leading-[1.1] mb-6">
            BabelFish — one engine for business functions in production.
          </h1>
        </Reveal>
        <Reveal delay={100}>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            The platform every tai42 application runs on — built on our
            open-source runtime, delivered as a private tenant your team
            operates, or self-hosted on your own infrastructure.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- What it runs — no fill of its own: it closes the hero's white band -->
    <section class="pb-20 lg:pb-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black mb-6">
            What it runs
          </h2>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            Not workflow runs — running operations. A BabelFish application is a
            long-lived machine: it waits, asks a customer or a colleague
            something, sleeps for a day, wakes on the reply, takes a payment
            that cannot be faked, and hands the hard cases to a human — holding
            identity, context, and commitments across restarts and days of
            silence.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- What you get -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black mb-10 lg:mb-14">
            What you get
          </h2>
        </Reveal>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
          <!-- 1 -->
          <Reveal delay={100}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <h3 class="text-xl font-bold text-black mb-3">
                Deterministic where it matters, generative where it's wanted.
              </h3>
              <p class="text-charcoal/70 leading-relaxed">
                Every application is split in two: explicit flows own the facts,
                the actions, and the money — prices, lookups, routing,
                commitments; models own the language — interpreting, phrasing,
                proposing. The AI has no tools: it cannot fetch data, quote a
                price, or take an action. Routing between steps is a fixed rule,
                never the model's choice, and unsafe structure is rejected
                before it can run. Over time the optimizer watches live behavior
                and compiles repeated model work into deterministic flows —
                human-approved, replay-validated, instantly reversible — so the
                application gets cheaper and more deterministic with use.
              </p>
              <ScreenshotSlot
                src="/images/platform/example-flow.png"
                alt="Deterministic where it matters, generative where it's wanted."
              />
            </div>
          </Reveal>

          <!-- 2 -->
          <Reveal delay={150}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <h3 class="text-xl font-bold text-black mb-3">
                Private tenant — or your own infrastructure.
              </h3>
              <p class="text-charcoal/70 leading-relaxed">
                A dedicated, EU-hosted tenant your team operates; or the
                open-source runtime on your own machines. Your AI keys, any
                model provider, swappable per step. Your data stays in your
                tenant or your environment.
              </p>
            </div>
          </Reveal>

          <!-- 3 -->
          <Reveal delay={200}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <h3 class="text-xl font-bold text-black mb-3">
                Always on our open-source runtime.
              </h3>
              <p class="text-charcoal/70 leading-relaxed">
                The engine underneath is public — read the code, run it, extend
                it. BabelFish is the hosted platform and enterprise layer built
                on it — never a different core.
                (→ <a href="/open-source/" class="font-medium text-crimson hover:text-burgundy transition-colors">/open-source</a>
                · → <a href={DOCS_URL} class="font-medium text-crimson hover:text-burgundy transition-colors">Docs</a>)
              </p>
            </div>
          </Reveal>

          <!-- 4 -->
          <Reveal delay={250}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <h3 class="text-xl font-bold text-black mb-3">
                The visual builder.
              </h3>
              <p class="text-charcoal/70 leading-relaxed">
                Build and change applications as configuration you keep —
                guardrails in place, every flow versioned, every change
                reviewable, rollback instant. Swap the model; keep the flows. No
                vendor holds your business logic, including us.
              </p>
              <ScreenshotSlot
                src="/images/platform/visual-builder.png"
                alt="the visual builder — guardrails, versioned flows, instant rollback"
              />
            </div>
          </Reveal>

          <!-- 5 -->
          <Reveal delay={300}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <h3 class="text-xl font-bold text-black mb-3">
                Audit and observability, by construction.
              </h3>
              <p class="text-charcoal/70 leading-relaxed">
                Every action traced, every flow versioned, every decision
                attributable — not an add-on, but the way the engine records
                reality. See what each application actually did: which step ran,
                which model was asked, which human decided, what moved.
              </p>
              <ScreenshotSlot
                src="/images/platform/audit-observability.png"
                alt="Audit and observability, by construction."
              />
            </div>
          </Reveal>

          <!-- 6 -->
          <Reveal delay={350}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <h3 class="text-xl font-bold text-black mb-3">
                Live in weeks, not quarters.
              </h3>
              <p class="text-charcoal/70 leading-relaxed">
                Applications ship as configuration on the platform, not product
                code — which is why an engagement is short and what you keep is
                a running application. Acceptance criteria you verify yourself;
                a license only if you keep it.
                (→ <a href="/method/" class="font-medium text-crimson hover:text-burgundy transition-colors">/method</a>)
              </p>
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- Getting started -->
    <section class="bg-white py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black mb-6">
            Getting started
          </h2>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            Enterprise pricing, sized to your tenant and usage — talk to us. The
            production readiness report is free: we assess your demo and your integration
            surface, and you leave with a written report whether or not we work
            together. No self-serve: the platform ships inside an engagement or
            a guided onboarding, because production systems deserve a running
            start.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- The honest line -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            Looking for something free to try? Our open-source runtime is public
            (→ <a href="/open-source/" class="font-medium text-crimson hover:text-burgundy transition-colors">/open-source</a>).
            If you're a builder who serves clients, join the founding waitlist
            (→ <a href="/builders/" class="font-medium text-crimson hover:text-burgundy transition-colors">/builders</a>).
            The platform itself is for teams already in production.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- Actions -->
    <section class="bg-white py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/contact/"
              class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
            >
              Get your production readiness report
            </a>
            <a
              href="/contact/"
              class="btn-hover inline-flex items-center justify-center bg-white text-charcoal border border-gray-200 hover:border-crimson/40 hover:text-crimson rounded-lg px-8 py-3.5 font-semibold transition-colors"
            >
              Talk to us about a tenant
            </a>
          </div>
        </Reveal>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
