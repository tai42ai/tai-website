---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";

export const prerender = true;
---

<BaseLayout
  title="Security — tai42"
  description="Open source, deterministic, and yours to run — self-host the open-source runtime on your own infrastructure, or run the hosted BabelFish platform in a private, dedicated, EU-hosted tenant your team operates."
>
  <NavBar />

  <main id="main-content">
    <!-- Hero section -->
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Reveal>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-black mb-6 tracking-tight">
            Security by architecture
          </h1>
        </Reveal>

        <Reveal delay={100}>
          <p class="text-xl text-charcoal/60 max-w-2xl mx-auto">
            Open source, deterministic, and yours to run — self-host the
            open-source runtime on your own infrastructure, or run the hosted
            BabelFish platform in a private, dedicated, EU-hosted tenant your
            team operates.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- Security features grid -->
    <section class="bg-gray-50 py-20 lg:py-28">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
          <!-- Open and auditable -->
          <Reveal delay={100}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <div class="flex items-start gap-3 mb-4">
                <svg class="w-6 h-6 text-crimson shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h3 class="text-lg font-bold text-black">Open and auditable</h3>
              </div>
              <p class="text-charcoal/60 text-sm leading-relaxed">
                The runtime underneath the platform is open source. Read the
                code and verify what it does.
              </p>
            </div>
          </Reveal>

          <!-- Self-host or hosted tenant -->
          <Reveal delay={200}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <div class="flex items-start gap-3 mb-4">
                <svg class="w-6 h-6 text-crimson shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h3 class="text-lg font-bold text-black">Your infrastructure, or your tenant</h3>
              </div>
              <p class="text-charcoal/60 text-sm leading-relaxed">
                Self-host the open-source runtime and it runs entirely on your
                own infrastructure — your prompts, payloads, data, and agents
                stay in your environment. The hosted BabelFish platform runs in
                a private, dedicated, EU-hosted tenant your team operates.
              </p>
            </div>
          </Reveal>

          <!-- Deterministic where it matters -->
          <Reveal delay={300}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <div class="flex items-start gap-3 mb-4">
                <svg class="w-6 h-6 text-crimson shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h3 class="text-lg font-bold text-black">Deterministic where it matters</h3>
              </div>
              <p class="text-charcoal/60 text-sm leading-relaxed">
                BabelFish runs explicit, deterministic flows; AI enters only
                where the application invites it, and the AI has no tools — it
                cannot fetch data, quote a price, or take an action. Routing
                between steps is a fixed rule, never the model's choice.
              </p>
            </div>
          </Reveal>

          <!-- No outbound calls from the self-hosted runtime -->
          <Reveal delay={400}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <div class="flex items-start gap-3 mb-4">
                <svg class="w-6 h-6 text-crimson shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h3 class="text-lg font-bold text-black">No outbound calls from the self-hosted runtime</h3>
              </div>
              <!-- VERIFY: engineering -->
              <p class="text-charcoal/60 text-sm leading-relaxed">
                The open-source runtime you self-host makes no outbound calls
                back to us and has no required cloud dependency.
              </p>
              <!-- VERIFY: engineering -->
              <p class="text-charcoal/60 text-sm leading-relaxed mt-3">
                Nothing about your workloads is reported to tai42.
              </p>
            </div>
          </Reveal>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
