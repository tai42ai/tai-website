---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";

export const prerender = true;

const GITHUB_URL = "https://github.com/tai42ai";
---

<BaseLayout
  title="Pricing - TAI42"
  description="Pricing for TAI42: the open-source platform is free forever, TAI42 Cloud is our managed service, and Babelfish Flows is our paid deterministic flow product."
>
  <NavBar />

  <main id="main-content" class="pt-20">
    <!-- Hero -->
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Reveal>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-black mb-6 tracking-tight">
            Pricing
          </h1>
        </Reveal>

        <Reveal delay={100}>
          <p class="text-xl text-charcoal/60 max-w-2xl mx-auto">
            The open-source platform is free forever. TAI42 Cloud and Babelfish
            Flows are our paid offerings - talk to us for access and terms.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- Three tiers -->
    <section class="bg-gray-50 py-20 lg:py-28">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
          <!-- Open-source platform -->
          <Reveal delay={100}>
            <div class="bg-white rounded-xl border border-gray-200 p-8 lg:p-10 text-center card-hover h-full flex flex-col">
              <span class="inline-block self-center font-mono text-sm font-semibold text-crimson bg-crimson/5 px-3 py-1 rounded-full mb-6">
                Open source
              </span>

              <h2 class="text-2xl font-bold text-black mb-2">Platform</h2>
              <p class="text-3xl font-bold text-black mb-6">Free <span class="text-base font-medium text-charcoal/50">forever</span></p>

              <p class="text-charcoal/70 leading-relaxed mb-8">
                The full MCP-native agent platform - framework, plugin ecosystem,
                Studio UI, and CLI. Self-host all of it, no limits, no phone-home.
              </p>

              <div class="mt-auto flex flex-col items-center gap-4">
                <a
                  href={GITHUB_URL}
                  target="_blank"
                  rel="noopener"
                  class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
                >
                  View on GitHub
                </a>
                <a
                  href="/open-source"
                  class="text-sm font-medium text-charcoal/50 hover:text-crimson transition-colors"
                >
                  About the platform &rarr;
                </a>
              </div>
            </div>
          </Reveal>

          <!-- TAI42 Cloud -->
          <Reveal delay={200}>
            <div class="bg-white rounded-xl border border-gray-200 p-8 lg:p-10 text-center card-hover h-full flex flex-col">
              <span class="inline-block self-center font-mono text-sm font-semibold text-crimson bg-crimson/5 px-3 py-1 rounded-full mb-6">
                Managed service
              </span>

              <h2 class="text-2xl font-bold text-black mb-2">TAI42 Cloud</h2>
              <p class="text-3xl font-bold text-black mb-6">Let&rsquo;s talk</p>

              <p class="text-charcoal/70 leading-relaxed mb-8">
                The managed service on top of the open-source platform. We run the
                stack, you run your agents. Talk to us for access and pricing that
                fits your scale.
              </p>

              <div class="mt-auto flex flex-col items-center gap-4">
                <a
                  href="/company/contact"
                  class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
                >
                  Talk to us
                </a>
                <a
                  href="/open-source"
                  class="text-sm font-medium text-charcoal/50 hover:text-crimson transition-colors"
                >
                  About the platform &rarr;
                </a>
              </div>
            </div>
          </Reveal>

          <!-- Babelfish Flows -->
          <Reveal delay={300}>
            <div class="bg-white rounded-xl border border-gray-200 p-8 lg:p-10 text-center card-hover h-full flex flex-col">
              <span class="inline-block self-center font-mono text-sm font-semibold text-crimson bg-crimson/5 px-3 py-1 rounded-full mb-6">
                Paid product
              </span>

              <h2 class="text-2xl font-bold text-black mb-2">Babelfish Flows</h2>
              <p class="text-3xl font-bold text-black mb-6">Let&rsquo;s talk</p>

              <p class="text-charcoal/70 leading-relaxed mb-8">
                The deterministic flow engine and Studio editor, a proprietary
                plugin you self-host on the open platform. Talk to us for access
                and licensing.
              </p>

              <div class="mt-auto flex flex-col items-center gap-4">
                <a
                  href="/company/contact"
                  class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
                >
                  Talk to us
                </a>
                <a
                  href="/babelfish"
                  class="text-sm font-medium text-charcoal/50 hover:text-crimson transition-colors"
                >
                  Explore Babelfish &rarr;
                </a>
              </div>
            </div>
          </Reveal>
        </div>

        <Reveal delay={400}>
          <p class="text-center text-sm text-charcoal/50 mt-10">
            Running at enterprise scale?
            <a href="/company/contact" class="font-medium text-crimson hover:text-burgundy transition-colors">Talk to us about enterprise &rarr;</a>
          </p>
        </Reveal>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
