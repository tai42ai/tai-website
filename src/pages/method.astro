---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";

export const prerender = true;

// The route stays /method — "How it works" is only the label. /how-it-works is
// an existing legacy redirect into this page, not a second page.

// The five steps render twice, in two registers: `short` in the overview strip
// (number badge + short title, one line), `title`/`body` in the detail blocks
// below it. The bodies are locked copy — verbatim, unchanged.
interface Step {
  short: string;
  title: string;
  body: string;
}

const STEPS: Step[] = [
  {
    short: "Readiness review",
    title: "The production readiness review (free, entry).",
    body:
      "From what you show us — a walkthrough of your demo and, if you can share them, its structural traces: the call graph without the data — we assess your demo, your definitions, and your integration surface. No system access. You leave with a written readiness report and a proposal — whether or not you continue with us.",
  },
  {
    short: "Readiness gate",
    title: "Stage 0 — the readiness gate.",
    body:
      "Scope, success metrics, and acceptance criteria agreed in writing. With access in place, we run your full traces through our platform and sharpen the flow map to what the system actually does. If your systems aren't ready, the clock pauses — your budget doesn't burn.",
  },
  {
    short: "Build",
    title: "The build.",
    body:
      "Your system on our platform: deterministic where it must be, intelligent where it should be, instrumented everywhere — weeks, not quarters.",
  },
  {
    short: "Acceptance",
    title: "Acceptance (your verification).",
    body:
      "Pass/fail criteria you test yourself — functional acceptance is never hostage to business luck, and business results are measured openly at the gate.",
  },
  {
    short: "Run",
    title: "Run (the license).",
    body:
      "Your team operates it on a private tenant — monitor, correct, and extend your own flows. We stay for the hard parts.",
  },
];

const REPORT_CONTENTS = [
  "The flow map — deterministic vs. generative. From your walkthrough — and from your structural traces if you can share them — we map your application: which steps are deterministic and belong in explicit flows — prices, lookups, routing, commitments, anything that must be right every time — and which genuinely need a model and stay generative. Structural traces are the call graph of your demo without its data: which step calls which system or model, in what order — the default most tracing tools export when prompts and outputs are hidden. (Once we're working together, we run your full traces through our platform and sharpen the map from evidence.)",
  "A readiness verdict in the production-readiness-review convention: ready, ready with conditions, or not ready — with blockers (fix before launch) and conditions (fix within an agreed window).",
  "A review of your definitions — what \"working\" means, and whether it's measurable as written.",
  "A map of your integration surface — the systems, data, channels, and payment paths a production application must touch.",
  "The gaps, in plain language, and what it would take to go live.",
  "A proposal, if we think we're the right team.",
];
---

<BaseLayout
  title="How it works — tai42"
  description="A production readiness review first. Weeks, not quarters, to a working system. Acceptance you verify yourself. A license only if you keep it."
>
  <NavBar />

  <main id="main-content">
    <!-- Hero -->
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-black leading-[1.1] mb-6">
            How it works
          </h1>
        </Reveal>
        <Reveal delay={100}>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            A production readiness review first. Weeks, not quarters, to a
            working system. Acceptance you verify yourself. A license only if
            you keep it.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- 1 — the five steps · 2 — what's in the production readiness report -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black mb-8">
            The five steps
          </h2>
        </Reveal>

        {/* Overview strip: number badge + short title, one line, connected by
            a thin rule. It scrolls sideways rather than wrapping mid-node on
            narrow screens; the rules are decoration. */}
        <Reveal delay={100} class="-mx-4 sm:mx-0 overflow-x-auto">
          <ol class="flex items-center gap-3 px-4 sm:px-0 w-max sm:w-auto sm:flex-wrap sm:gap-y-4">
            {STEPS.map((step, i) => (
              <li class="flex items-center gap-3 shrink-0">
                <span class="shrink-0 w-8 h-8 rounded-full bg-crimson/10 text-crimson font-mono text-sm font-semibold flex items-center justify-center">
                  {i + 1}
                </span>
                <span class="text-sm font-semibold text-black whitespace-nowrap">
                  {step.short}
                </span>
                {i < STEPS.length - 1 && (
                  <span class="w-6 h-px bg-gray-200" aria-hidden="true"></span>
                )}
              </li>
            ))}
          </ol>
        </Reveal>

        <Reveal delay={150}>
          <p class="mt-6 text-charcoal/70 leading-relaxed">
            Every phase ends at a written gate. You can stop at any of them —
            which is exactly why clients don't.
          </p>
        </Reveal>

        {/* Detail blocks: the same five steps, stacked, one number each. */}
        <div class="mt-12 lg:mt-14 space-y-6">
          {STEPS.map((step, i) => (
            <Reveal delay={100 + i * 60}>
              <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8">
                <div class="flex items-center gap-3 mb-3">
                  <span class="shrink-0 w-9 h-9 rounded-full bg-crimson/10 text-crimson font-mono font-semibold flex items-center justify-center">
                    {i + 1}
                  </span>
                  <h3 class="text-base font-bold text-black">{step.title}</h3>
                </div>
                <p class="text-charcoal/70 leading-relaxed">{step.body}</p>
              </div>
            </Reveal>
          ))}
        </div>
      </div>

      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 lg:mt-20">
        <Reveal>
          <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8">
            <h2 class="text-2xl sm:text-3xl font-bold text-black mb-5">
              What's in the production readiness report
            </h2>
            <p class="text-charcoal/70 leading-relaxed">
              A short written document, built from your three answers, one
              working session in which you walk us through your demo, and — if
              you can share them — its structural traces. No system access, no
              data. Yours whether or not we work together. It contains:
            </p>
            <ul class="mt-6 space-y-4">
              {REPORT_CONTENTS.map((entry) => (
                <li class="flex gap-3 text-charcoal/70 leading-relaxed">
                  <span class="mt-2.5 shrink-0 w-1.5 h-1.5 rounded-full bg-crimson/60"></span>
                  <span>{entry}</span>
                </li>
              ))}
            </ul>
          </div>
        </Reveal>
      </div>
    </section>

    <!-- 3 — Where humans stay -->
    <section class="bg-white py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black mb-6">
            Where humans stay
          </h2>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            Your people at the decisions you name; ours on call for the hard
            cases — always with the full history attached.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- 4 — What we ask of you · 5 — What you keep -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
          <Reveal>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <h2 class="text-2xl font-bold text-black mb-4">
                What we ask of you
              </h2>
              <p class="text-charcoal/70 leading-relaxed">
                A working demo you can walk us through. If you can, its
                structural traces — the call graph without the content:
                exported from your tracing tool with prompts, outputs, and tool
                payloads hidden; we'll tell you exactly how. No system access
                and no data for the report. Written answers to what it should
                achieve and how you'll measure it. A named person who can
                decide. And, once we're working together: full traces and access
                to the systems the application must touch before the build
                starts — because when those are ready, the build is short, and
                when they aren't, we pause rather than pretend.
              </p>
            </div>
          </Reveal>

          <Reveal delay={100}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <h2 class="text-2xl font-bold text-black mb-4">What you keep</h2>
              <p class="text-charcoal/70 leading-relaxed">
                A running production application on a private tenant your team
                operates. Your flows as configuration you keep, independent of
                any model vendor. The acceptance record. The report. And us, on
                call for the hard parts.
              </p>
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- 6 — Who we work with -->
    <section class="bg-white py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black mb-6">
            Who we work with
          </h2>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            You already have a demo. You've written down what it should achieve.
            You know how you'd measure success. It doesn't work in production
            yet. If that's you, the report will be useful even if we never work
            together. If you're still exploring what AI could do for you — we're
            not your first stop, and we'll say so.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <a
            href="/contact/"
            class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
          >
            Get your production readiness report
          </a>
        </Reveal>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
