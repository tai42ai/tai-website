---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar from "../../components/NavBar.astro";
import Footer from "../../components/Footer.astro";
import Reveal from "../../components/Reveal.astro";

export const prerender = true;
---

<BaseLayout title="About - TAI42">
  <NavBar />

  <main id="main-content" class="pt-20">
    <!-- Mission section -->
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-black mb-8 tracking-tight">
            The Open Agent Platform Company.
          </h1>
        </Reveal>

        <Reveal delay={100}>
          <p class="text-lg text-charcoal/70 leading-relaxed mb-6">
            We started TAI42 with a simple belief: the platform your agents run on should be open. That&rsquo;s why the core of everything we build - an MCP-native agent framework, a plugin ecosystem, the Studio UI, and a CLI - is open source and self-hostable. No lock-in, no black boxes; you can read every line of the stack you run.
          </p>
        </Reveal>

        <Reveal delay={200}>
          <p class="text-lg text-charcoal/70 leading-relaxed">
            On top of the open platform we build Babelfish Flows, our paid product for teams that need agents to behave deterministically in production: a deterministic flow engine and Studio editor for authoring auditable, versioned flows. Open platform, deterministic product - that&rsquo;s the whole company.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- Team section -->
    <section class="bg-gray-50 py-20 lg:py-28">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <p class="text-sm font-mono font-medium tracking-wider uppercase text-charcoal/40 text-center mb-3">
            Leadership
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-black text-center mb-12">
            The Team Behind TAI42
          </h2>
        </Reveal>

        <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
          <!-- Miki Balin -->
          <Reveal delay={100}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <h3 class="text-lg font-bold text-black mb-1">Miki Balin</h3>
              <p class="text-sm font-medium text-crimson mb-4">Founder &amp; CEO</p>
              <p class="text-charcoal/60 text-sm leading-relaxed">
                Background in enterprise infrastructure. Building the open platform agents run on. Previously led engineering teams scaling distributed systems at enterprise scale.
              </p>
            </div>
          </Reveal>

          <!-- Daniel Frank -->
          <Reveal delay={200}>
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:p-8 h-full">
              <h3 class="text-lg font-bold text-black mb-1">Daniel Frank</h3>
              <p class="text-sm font-medium text-crimson mb-4">Co-Founder &amp; CTO</p>
              <p class="text-charcoal/60 text-sm leading-relaxed">
                Background in compiler engineering. Architecting the Babelfish flow engine. Deep expertise in compiler design, deterministic systems, and high-throughput data pipelines.
              </p>
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- Investor callout -->
    <section class="bg-white py-16 lg:py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Reveal delay={100}>
          <p class="text-lg text-charcoal/60 italic">
            Backed by top infrastructure investors. Seed round announcement coming soon.
          </p>
        </Reveal>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
