---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";

export const prerender = true;

const GITHUB_URL = "https://github.com/tai42ai";
const DOCS_URL = "https://docs.tai42.ai";
---

<BaseLayout
  title="Open Source Platform - TAI42"
  description="The TAI42 open-source platform: an MCP-native agent-platform ecosystem with a framework skeleton, plugin ecosystem, Studio UI, and CLI. Self-host it today."
>
  <NavBar />

  <main id="main-content" class="pt-20">
    <!-- Hero -->
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Reveal>
          <p class="text-xs uppercase tracking-widest font-mono text-crimson mb-4">
            OPEN SOURCE
          </p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-black mb-6 tracking-tight">
            An agent platform you actually own.
          </h1>
        </Reveal>

        <Reveal delay={100}>
          <p class="text-xl text-charcoal/60 max-w-2xl mx-auto mb-8">
            The TAI42 platform is an MCP-native agent-platform ecosystem -
            open source, self-hostable, and built to be extended. Every layer,
            from the runtime to the UI, lives in the open.
          </p>
        </Reveal>

        <Reveal delay={150}>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <a
              href={GITHUB_URL}
              target="_blank"
              rel="noopener"
              class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-6 py-3 font-semibold transition-colors"
            >
              View on GitHub
            </a>
            <a
              href={DOCS_URL}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center border-2 border-crimson text-crimson hover:bg-crimson hover:text-white rounded-lg px-6 py-3 font-semibold transition-colors"
            >
              Read the docs
            </a>
          </div>
        </Reveal>
      </div>
    </section>

    <!-- What's in the platform -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black text-center mb-6">
            What&rsquo;s in the platform.
          </h2>
        </Reveal>

        <Reveal delay={100}>
          <p class="text-charcoal/70 text-center max-w-2xl mx-auto mb-14 leading-relaxed">
            Four building blocks that work together - use the whole stack or
            just the pieces you need.
          </p>
        </Reveal>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Framework skeleton -->
          <Reveal delay={150}>
            <div class="card-hover bg-white rounded-xl border border-gray-200 p-6 h-full">
              <div class="w-10 h-10 rounded-full bg-crimson/10 flex items-center justify-center mb-4">
                <svg class="w-5 h-5 text-crimson" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" />
                </svg>
              </div>
              <h3 class="font-bold text-black text-base mb-2">Framework skeleton</h3>
              <p class="text-sm text-charcoal/60 leading-relaxed">
                A production-shaped agent runtime with MCP at its core. Tools,
                memory, and model access are all first-class, swappable pieces -
                not framework lock-in.
              </p>
            </div>
          </Reveal>

          <!-- Plugin ecosystem -->
          <Reveal delay={225}>
            <div class="card-hover bg-white rounded-xl border border-gray-200 p-6 h-full">
              <div class="w-10 h-10 rounded-full bg-crimson/10 flex items-center justify-center mb-4">
                <svg class="w-5 h-5 text-crimson" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 01-.657.643 48.39 48.39 0 01-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 01-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 00-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 01-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 00.657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 01-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 005.427-.63 48.05 48.05 0 00.582-4.717.532.532 0 00-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401v0a.656.656 0 00.658-.663 48.422 48.422 0 00-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 01-.61-.58v0z" />
                </svg>
              </div>
              <h3 class="font-bold text-black text-base mb-2">Plugin ecosystem</h3>
              <p class="text-sm text-charcoal/60 leading-relaxed">
                Capabilities ship as plugins you install like packages. Add
                integrations, tools, and behaviors without forking the platform -
                and publish your own for others to use.
              </p>
            </div>
          </Reveal>

          <!-- Studio UI -->
          <Reveal delay={300}>
            <div class="card-hover bg-white rounded-xl border border-gray-200 p-6 h-full">
              <div class="w-10 h-10 rounded-full bg-crimson/10 flex items-center justify-center mb-4">
                <svg class="w-5 h-5 text-crimson" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
                </svg>
              </div>
              <h3 class="font-bold text-black text-base mb-2">Studio UI</h3>
              <p class="text-sm text-charcoal/60 leading-relaxed">
                A visual workspace for your agents: configure them, watch them
                run, inspect every step, and manage plugins - all from the
                browser, on your own infrastructure.
              </p>
            </div>
          </Reveal>

          <!-- CLI -->
          <Reveal delay={375}>
            <div class="card-hover bg-white rounded-xl border border-gray-200 p-6 h-full">
              <div class="w-10 h-10 rounded-full bg-crimson/10 flex items-center justify-center mb-4">
                <svg class="w-5 h-5 text-crimson" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z" />
                </svg>
              </div>
              <h3 class="font-bold text-black text-base mb-2">CLI</h3>
              <p class="text-sm text-charcoal/60 leading-relaxed">
                Everything the Studio does, scriptable from the terminal.
                Scaffold agents, install plugins, run flows, and wire the
                platform into your CI.
              </p>
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- Self-host -->
    <section class="bg-white py-20 lg:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Reveal>
          <h2 class="text-3xl sm:text-4xl font-bold text-black mb-6">
            Self-host it. All of it.
          </h2>
        </Reveal>
        <Reveal delay={100}>
          <p class="text-charcoal/70 leading-relaxed mb-8">
            The whole platform runs on your infrastructure - no required cloud
            dependency, no phone-home. Clone the repos, follow the docs, and
            you&rsquo;re running the same stack we do.
          </p>
        </Reveal>
        <Reveal delay={150}>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <a
              href={GITHUB_URL}
              target="_blank"
              rel="noopener"
              class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-6 py-3 font-semibold transition-colors"
            >
              GitHub
            </a>
            <a
              href={DOCS_URL}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center border-2 border-crimson text-crimson hover:bg-crimson hover:text-white rounded-lg px-6 py-3 font-semibold transition-colors"
            >
              Self-hosting docs
            </a>
          </div>
        </Reveal>
      </div>
    </section>

    <!-- TAI42 Cloud -->
    <section class="bg-gray-50 py-20 lg:py-24">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <div class="bg-white rounded-xl border border-gray-200 p-8 lg:p-12 text-center card-hover">
            <span class="inline-block font-mono text-sm font-semibold text-crimson bg-crimson/5 px-3 py-1 rounded-full mb-6">
              Managed service
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-black mb-4">
              TAI42 Cloud
            </h2>
            <p class="text-lg text-charcoal/70 leading-relaxed mb-8">
              A managed service on top of the open-source platform. Same stack,
              zero ops: we run the platform, you run your agents. Talk to us for
              access.
            </p>
            <div class="flex flex-col items-center gap-4">
              <a
                href="/company/contact"
                class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
              >
                Talk to us
              </a>
              <a
                href="/pricing"
                class="text-sm font-medium text-charcoal/50 hover:text-crimson transition-colors"
              >
                See pricing &rarr;
              </a>
            </div>
          </div>
        </Reveal>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
