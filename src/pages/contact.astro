---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";

export const prerender = true;

// No form, no form backend, no thank-you page (decision 20 Aug). The three
// questions are plain text and the primary button is a mailto: with the subject
// and the questions pre-filled, so the answers arrive as an ordinary email in
// the contact@ Group mailbox. contact@tai42.ai is deliberately public here.
const MAIL_TO = "contact@tai42.ai";
const SUBJECT = "Production readiness report";
// One prompt per line, each followed by a blank line, so the sender types under
// each. encodeURIComponent turns the \r\n pairs into %0D%0A, which is what mail
// clients expect in a mailto body.
const PROMPTS = [
  "Do you have a working demo today? (paste a link, a video, or a sentence)",
  "What breaks — or what's stopping you from putting it in front of real users?",
  "How will you measure success in production?",
  "Name / Company:",
];
const BODY = PROMPTS.map((prompt) => `${prompt}\r\n\r\n`).join("");
const MAILTO_HREF = `mailto:${MAIL_TO}?subject=${encodeURIComponent(
  SUBJECT
)}&body=${encodeURIComponent(BODY)}`;
---

<BaseLayout
  title="Three questions. They save us both a meeting. — tai42"
  description="Three questions. They save us both a meeting."
>
  <NavBar />

  <main id="main-content">
    <section class="bg-white py-20 lg:py-24">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-black leading-[1.1] mb-10">
            Three questions. They save us both a meeting.
          </h1>
        </Reveal>

        <Reveal delay={100}>
          <ol class="space-y-6">
            <li class="flex gap-3">
              <span class="shrink-0 w-5 text-base font-semibold text-crimson/70 leading-relaxed">1</span>
              <div>
                <p class="text-lg text-black leading-relaxed">
                  Do you have a working demo today?
                </p>
                <p class="mt-1.5 text-sm text-charcoal/60 leading-relaxed">
                  Paste a link, a video, or a sentence — anything that shows what
                  you've built.
                </p>
              </div>
            </li>
            <li class="flex gap-3">
              <span class="shrink-0 w-5 text-base font-semibold text-crimson/70 leading-relaxed">2</span>
              <p class="text-lg text-black leading-relaxed">
                What breaks — or what's stopping you from putting it in front of
                real users?
              </p>
            </li>
            <li class="flex gap-3">
              <span class="shrink-0 w-5 text-base font-semibold text-crimson/70 leading-relaxed">3</span>
              <p class="text-lg text-black leading-relaxed">
                How will you measure success in production?
              </p>
            </li>
          </ol>
        </Reveal>

        <Reveal delay={200}>
          <div class="mt-10">
            <a
              href={MAILTO_HREF}
              class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
            >
              Get your production readiness report
            </a>
            <p class="mt-4 text-sm text-charcoal/60 leading-relaxed">
              or write to <a
                href={`mailto:${MAIL_TO}`}
                class="font-medium text-crimson hover:text-burgundy transition-colors"
                >contact@tai42.ai</a
              > — we read everything and reply with a time to talk.
            </p>
          </div>
        </Reveal>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
