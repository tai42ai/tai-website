---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";
import FormSourceScript from "../components/FormSourceScript.astro";

export const prerender = true;

// Formspree — a plain HTML POST, no dependency and nothing rendered as text.
// PENDING_FOUNDER is a sentinel, not a value we invented: the founder creates
// the form under contact@tai42.ai and swaps this one constant for its ID. The
// delivery address is configured account-side, never in the markup.
const FORMSPREE_CONTACT_ID = "PENDING_FOUNDER";
const FORM_ENDPOINT = `https://formspree.io/f/${FORMSPREE_CONTACT_ID}`;
const THANK_YOU_REDIRECT = "https://tai42.ai/thank-you/";
// The company is appended live by FormSourceScript: "… — {company}".
const SUBJECT = "[tai42] Readiness report request";

const inputClass =
  "w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-charcoal placeholder:text-charcoal/30 focus:border-crimson focus:outline-none focus:ring-1 focus:ring-crimson transition-colors";
const labelClass = "block text-sm font-medium text-black mb-2";
---

<BaseLayout
  title="Three questions. They save us both a meeting. — tai42"
  description="Three questions. They save us both a meeting."
>
  <NavBar />

  <main id="main-content">
    <section class="bg-white py-20 lg:py-24">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <Reveal>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-black leading-[1.1] mb-10">
            Three questions. They save us both a meeting.
          </h1>
        </Reveal>

        <Reveal delay={100}>
          <form
            action={FORM_ENDPOINT}
            method="POST"
            data-source-form
            class="space-y-6"
          >
            <input type="hidden" name="_subject" value={SUBJECT} />
            <input type="hidden" name="_next" value={THANK_YOU_REDIRECT} />
            <input type="hidden" name="source" value="" />
            <!-- Formspree honeypot -->
            <input
              type="text"
              name="_gotcha"
              class="hidden"
              style="display:none"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <!-- The demo question, given the weight it deserves: it is the one
                 answer the readiness report is built from. Optional but
                 encouraged — said in the label, not only in the helper text, so
                 it reaches screen readers as well. -->
            <div class="rounded-xl border border-gray-200 bg-gray-50 p-5 lg:p-6">
              <label class="block text-base font-semibold text-black mb-1.5" for="demo">
                Do you have a working demo today? (optional)
              </label>
              <p id="demo-help" class="text-sm text-charcoal/60 leading-relaxed mb-3">
                Paste a link, a video, or a sentence — anything that shows what
                you've built.
              </p>
              <textarea
                id="demo"
                name="Do you have a working demo today?"
                rows="4"
                aria-describedby="demo-help"
                class={inputClass}></textarea>
            </div>

            <div>
              <label class={labelClass} for="breaks">
                What breaks — or what's stopping you from putting it in front of
                real users?
              </label>
              <textarea id="breaks" name="What breaks, or what's stopping you from putting it in front of real users?" rows="4" required class={inputClass}></textarea>
            </div>

            <div>
              <label class={labelClass} for="success">
                How will you measure success in production?
              </label>
              <textarea id="success" name="How will you measure success in production?" rows="3" required class={inputClass}></textarea>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class={labelClass} for="name">Name</label>
                <input id="name" name="name" type="text" required autocomplete="name" class={inputClass} />
              </div>
              <div>
                <label class={labelClass} for="company">Company</label>
                <input id="company" name="company" type="text" required autocomplete="organization" class={inputClass} />
              </div>
            </div>

            <div>
              <label class={labelClass} for="email">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" class={inputClass} />
            </div>

            <button
              type="submit"
              class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
            >
              Get your readiness report
            </button>
          </form>
        </Reveal>
      </div>
    </section>

    <FormSourceScript />
  </main>

  <Footer />
</BaseLayout>
