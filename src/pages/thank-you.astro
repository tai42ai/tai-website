---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";
import FormSubmissionEvent from "../components/FormSubmissionEvent.astro";
import { CALENDAR_URL } from "../consts";

export const prerender = true;

// The CONTACT form's thank-you page — and the only page on the site that
// carries the calendar URL. Form first, calendar second: by the time anyone
// sees this, we already have their three answers.
---

<BaseLayout
  title="Thank you — tai42"
  description="Thanks — we'll read this before we meet."
  noindex
>
  <NavBar />

  <main id="main-content">
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Reveal>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-black leading-[1.1] mb-6">
            Thanks — we'll read this before we meet.
          </h1>
          <p class="text-lg text-charcoal/70 leading-relaxed mb-10">
            Pick a time and we'll come to the call having read what you sent.
          </p>
          <a
            href={CALENDAR_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
          >
            Pick a time.
          </a>
        </Reveal>
      </div>
    </section>

    <FormSubmissionEvent page="contact" />
  </main>

  <Footer />
</BaseLayout>
