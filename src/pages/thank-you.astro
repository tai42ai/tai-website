---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";

export const prerender = true;

const CALENDAR_URL =
  "https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ3qmPX-JW-HScqfCyMv1v_hyyxGRl2J8b7JOptbl36xFUSe7oz3AvSASK-SYjBeswKDpQcLIn2n";
---

<BaseLayout
  title="Thank you — tai42"
  description="Your answers are with us. Pick a time that suits you."
  noindex
>
  <NavBar />

  <main id="main-content">
    <section class="bg-white py-20 lg:py-28">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Reveal>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-black leading-[1.1] mb-6">
            Thank you
          </h1>
          <p class="text-lg text-charcoal/70 leading-relaxed mb-10">
            Your answers are with us. Pick a time that suits you.
          </p>
          <a
            href={CALENDAR_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-hover inline-flex items-center justify-center bg-crimson text-white hover:bg-burgundy rounded-lg px-8 py-3.5 font-semibold transition-colors"
          >
            Book a production audit
          </a>
        </Reveal>
      </div>
    </section>

    <script is:inline>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var page = params.get("page") || "";
        var source = params.get("source") || "";
        if (!page) return;

        var key = "qualified_form_submission:" + page + ":" + source;
        try {
          if (window.sessionStorage.getItem(key)) return;
          window.sessionStorage.setItem(key, "1");
        } catch (e) {
          /* private mode — fire anyway */
        }

        if (typeof window.plausible === "function") {
          window.plausible("qualified_form_submission", {
            props: { page: page, source: source },
          });
        }
      })();
    </script>
  </main>

  <Footer />
</BaseLayout>
